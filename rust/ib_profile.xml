<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-level Incredibuild Linux profile.

  This structure is copied from the version 4.29.1 template at
  /opt/incredibuild/data/custom_profiles/rustrover/ib_profile.xml and is
  validated by /opt/incredibuild/data/ib_profile.xsd during the Linux E2E.

  Incredibuild loads $PWD/ib_profile.xml with highest precedence. The runner
  scripts invoke ib_console from this rust/ directory, so this is the active
  profile. Cargo is intercepted by ib_console; rustc work is eligible for
  remote execution and compilation caching. Tests and simulator checks run
  outside ib_console and are always re-executed.
-->
<ib_profile version="1">
  <globals
    ignore_following_profiles="false"
    dummy_mode="false"
    monitor_enable="false"
    local_slot_priority="low"
    requested_cores="10000"
  />
  <processes>
    <process filename="rustc" type="allow_remote">
      <ib_cache enabled="true" />
    </process>
  </processes>
</ib_profile>
