+/// A sensor path with a queue in it: the duck's senses, delayed.
+///
+/// Reads the backend fresh on every tick, keeps what comes back, and hands up the newest
+/// sample that is already at least `delay` old. Writes, gains, torque, reboots and slow
+/// sensors pass straight through, so the duck really is being driven at fifty hertz — only
+/// its perception is behind.
+///
+/// **It cannot lie about the fault it injects.** [`Sensors::observed_at`] is a
+/// [`std::time::Instant`], and `Instant::now` is its only constructor, so a ring can *keep* a
+/// stamp and can never *write* one. The age the safety layer computes is therefore the truth
+/// about that sample even though the thing that handed it over was built to deceive. That
+/// property is not this type's good behaviour; it is the type system's.
+///
+/// **It is not a simulation of a fault.** A buffering sensor driver, an SDK that batches, a
+/// message queue with a depth — all of them are exactly this, and none of them is a bug. The
+/// bug is downstream, where nobody asks how old the answer is.
+///
+/// **It cannot reach a real robot.** It lives in the `sim` module and `robotd` only wraps the
+/// [`RemoteIo`] it builds on the `--sim` path; `--stale-sensors-ms` `requires = "sim"` and is
+/// start-time only, so there is no code path from a Dynamixel bus to one of these and no live
+/// knob that can turn one on.
+///
+/// Why a ring rather than simply holding the reply back: [`TIMEOUT`] is 200 ms and the protocol
+/// is synchronous request/response, so a proxy that slept on the answer would not delay the
+/// observation — it would collapse the control loop to a few hertz, and the loop rate is the
+/// one thing this demonstration needs to leave untouched.
+pub struct StaleIo<T: RobotIo> {
+    inner: T,
+    delay: Duration,
+    /// Samples read but not yet old enough to serve, oldest first. Bounded by `delay` over the
+    /// tick period — about five entries at 50 Hz and 100 ms — because everything that falls
+    /// behind the one being served is dropped on the next read.
+    ring: VecDeque<Sensors>,
+}
+
+impl<T: RobotIo> StaleIo<T> {
+    pub fn delaying(inner: T, delay: Duration) -> Self {
+        Self {
+            inner,
+            delay,
+            ring: VecDeque::new(),
+        }
+    }
+}
+
+impl<T: RobotIo> RobotIo for StaleIo<T> {
+    fn read(&mut self) -> Result<Sensors> {
+        // Fresh every tick, and the error is passed straight up: a backend that has gone away
+        // must still look like a backend that has gone away, not like one answering slowly.
+        self.ring.push_back(self.inner.read()?);
+
+        // Serve the front, having first dropped everything the next entry has made redundant.
+        // While the ring is still filling, the front is the oldest thing there is and is served
+        // young — so the first few ticks of a run warm up honestly rather than pretending to a
+        // delay that has not accumulated yet.
+        while self.ring.len() > 1 && self.ring[1].observed_at().elapsed() >= self.delay {
+            self.ring.pop_front();
+        }
+        Ok(*self.ring.front().expect("a sample was just pushed"))
+    }
+
+    fn write(&mut self, targets: &JointTargets) -> Result<()> {
+        self.inner.write(targets)
+    }
+
+    fn set_gain(&mut self, kp: u16) -> Result<()> {
+        self.inner.set_gain(kp)
+    }
+
+    fn set_torque(&mut self, on: bool) -> Result<()> {
+        self.inner.set_torque(on)
+    }
+
+    fn reboot(&mut self, id: u8) -> Result<()> {
+        self.inner.reboot(id)
+    }
+
+    fn slow_sensors(&mut self) -> Result<SlowSensors> {
+        self.inner.slow_sensors()
+    }
+
+    fn measures_velocity(&self) -> bool {
+        self.inner.measures_velocity()
+    }
+
+    fn measures_load(&self) -> bool {
+        self.inner.measures_load()
+    }
+
+    fn imu_stale(&self) -> crate::io::ImuStale {
+        self.inner.imu_stale()
+    }
+
+    fn imu_ready(&self) -> bool {
+        self.inner.imu_ready()
+    }
+}
