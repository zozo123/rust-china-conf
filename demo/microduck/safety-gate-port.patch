index 0000000..6c7da34
--- /dev/null
+++ b/scripts/duck-demo/swap-robotd.sh
@@ -0,0 +1,59 @@
+#!/bin/sh
+# Restart *only* robotd, with a given `--stale-sensors-ms`, leaving the body standing.
+#
+# The MuJoCo world is the expensive thing to start and the daemon is the cheap one, so the
+# matrix swaps daemons and keeps the world. What this costs is a stand: killing robotd runs
+# its graceful shutdown, which sits the duck down and cuts torque, so every swap has to put
+# the duck back on its feet before anything is measured — otherwise the next scenario is a
+# measurement of a duck lying on the floor.
+set -eu
+
+STALE="${1:-0}"
+STATE="${DUCK_SIM_STATE:-$HOME/.cache/duck-sim}"
+RL="${DUCK_SIM_RL:-$HOME/Pollen/microduck_rl}"
+PORT="${DUCK_SIM_PORT:-7801}"
+REPO="$(cd "$(dirname "$0")/../.." && pwd)"
+NAME=duck-a
+
+ORT="$(find "$RL"/.venv/lib/python*/site-packages/onnxruntime/capi \
+        \( -name 'libonnxruntime.so*' -o -name 'libonnxruntime*.dylib' \) -type f 2>/dev/null | head -1)"
+[ -n "$ORT" ] || { echo "no onnxruntime in $RL/.venv" >&2; exit 1; }
+
+if [ -f "$STATE/$NAME.pid" ]; then
+    pid="$(cat "$STATE/$NAME.pid")"
+    if kill -0 "$pid" 2>/dev/null && ps -o args= -p "$pid" | grep -q "$STATE/$NAME.sock"; then
+        kill -TERM "$pid" 2>/dev/null || true
+        # The shutdown sit takes a moment; waiting for it is what keeps the next start clean.
+        i=0; while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 60 ]; do sleep 0.1; i=$((i+1)); done
+    fi
+fi
+rm -f "$STATE/$NAME.sock"
+
+if [ "$STALE" = 0 ]; then set --; else set -- --stale-sensors-ms "$STALE"; fi
+DUCK_IDENTITY="$NAME" DUCK_RUNTIME_DIR="$STATE" ORT_DYLIB_PATH="$ORT" RUST_LOG="${RUST_LOG:-info}" \
+    nohup "$REPO/target/debug/robotd" --sim "127.0.0.1:$PORT" "$@" \
+    --params "$STATE/robotd-$NAME.toml" --socket "$STATE/$NAME.sock" \
+    > "$STATE/$NAME.log" 2>&1 &
+echo $! > "$STATE/$NAME.pid"
+
+i=0
+while [ ! -S "$STATE/$NAME.sock" ] && [ "$i" -lt 300 ]; do sleep 0.1; i=$((i+1)); done
+[ -S "$STATE/$NAME.sock" ] || { echo "robotd did not come up; see $STATE/$NAME.log" >&2; exit 1; }
+
+# `robot.enable`, not `robot init` — `init` position-ramps with nothing balancing and tips the
+# duck flat. `enable` hands it straight to the policy, which stands itself up from a sit.
+python3 - "$STATE/$NAME.sock" <<'PY'
+import json, socket, sys, time
+for _ in range(50):
+    try:
+        s = socket.socket(socket.AF_UNIX); s.settimeout(5); s.connect(sys.argv[1]); break
+    except OSError:
+        time.sleep(0.1)
+else:
+    sys.exit("robotd socket never accepted")
+f = s.makefile("rw")
+f.write(json.dumps({"jsonrpc":"2.0","id":1,"method":"robot.enable","params":{"on":True}}) + "\n")
+f.flush()
+sys.exit(0 if json.loads(f.readline()).get("result", {}).get("accepted") else 1)
+PY
+sleep 6
diff --git a/scripts/duck-demo/verify.py b/scripts/duck-demo/verify.py
new file mode 100644
index 0000000..73fde6c
--- /dev/null
+++ b/scripts/duck-demo/verify.py
@@ -0,0 +1,326 @@
+#!/usr/bin/env python3
+"""Re-derive the verdict for an evidence directory, from its traces and nothing else.
+
+Protected in the sense the ported demo means it: **every expectation comes from this
+checkout** — `scenarios/*.json` and `coverage-matrix.json`, read relative to this file — and
+never from the evidence directory being judged. An evidence bundle can therefore claim
+whatever it likes about itself; it does not get to say what passing is.
+
+The other half of that discipline is that the numbers come from the *traces*, not from
+`scenario-results.json`. The results file is cross-checked against the trace and a
+disagreement is itself a failure, which is what stops a run from being graded on its own
+summary.
+
+Honesty caveat, carried verbatim from the demo this is a port of: a digest identifies an
+artifact; it is not by itself independent proof that untrusted evidence was produced by that
+executable.
+"""
+
+import argparse
+import hashlib
+import json
+import math
+import statistics
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+
+# What the loop has to have been doing for a verdict to mean anything. The hook is that
+# *nothing was broken except perception*, so a run where the loop itself faltered proves the
+# wrong thing and is refused rather than graded.
+MIN_HZ = 47.0
+MAX_MISSED_GROWTH = 20
+
+
+class Verdict:
+    def __init__(self):
+        self.failures = []
+        self.checks = 0
+
+    def require(self, ok, scenario, message):
+        self.checks += 1
+        if not ok:
+            self.failures.append(f"{scenario}: {message}")
+        return ok
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_scenarios():
+    return {
+        json.loads(path.read_text())["name"]: json.loads(path.read_text())
+        for path in sorted((HERE / "scenarios").glob("*.json"))
+    }
+
+
+def read_ticks(path):
+    ticks = []
+    if not path.exists():
+        return ticks
+    with open(path) as stream:
+        for line in stream:
+            try:
+                frame = json.loads(line)
+            except json.JSONDecodeError:
+                continue
+            state = frame.get("params")
+            if isinstance(state, dict) and "loop" in state:
+                ticks.append(state)
+    return ticks
+
+
+def read_referee(path):
+    if not path.exists():
+        return []
+    return [json.loads(line) for line in open(path) if line.strip()]
+
+
+def driving_ticks(ticks):
+    return [
+        t
+        for t in ticks
+        if any(abs(v) > 1e-9 for v in t.get("move", {}).get("requested", []))
+    ]
+
+
+def displacement(samples):
+    if len(samples) < 2:
+        return 0.0
+    a, b = samples[0]["trunk"], samples[-1]["trunk"]
+    return math.hypot(b[0] - a[0], b[1] - a[1])
+
+
+def yaw_change(samples):
+    if len(samples) < 2:
+        return 0.0
+    total, last = 0.0, samples[0]["yaw"]
+    for sample in samples[1:]:
+        step = sample["yaw"] - last
+        total += math.atan2(math.sin(step), math.cos(step))
+        last = sample["yaw"]
+    return total
+
+
+def verify(evidence, verdict):
+    evidence = Path(evidence)
+    manifest = json.loads((evidence / "manifest.json").read_text())
+    revision = manifest["revision"]
+    declared = json.loads((evidence / "scenario-results.json").read_text())
+    by_name = {r["scenario"]: r for r in declared}
+    scenarios = load_scenarios()
+    coverage = json.loads((HERE / "coverage-matrix.json").read_text())
+
+    # ── the evidence is bound to a binary ─────────────────────────────────────
+    binary = evidence / manifest["executable"]["path"]
+    verdict.require(
+        binary.exists() and sha256(binary) == manifest["executable"]["sha256"],
+        "manifest",
+        "the exported executable's sha256 does not match the manifest",
+    )
+    # ── the threshold is arithmetic on the control period, not a loose number ──
+    control = manifest["control"]
+    verdict.require(
+        control["period_ms"] * (control["coast_ticks"] + 1)
+        == manifest["policy_observation_max_age_ms"],
+        "manifest",
+        f"the {manifest['policy_observation_max_age_ms']} ms bound is not "
+        f"{control['period_ms']} ms x ({control['coast_ticks']} + 1) — the threshold has been "
+        "re-derived from a different loop rate",
+    )
+    # ── the matrix covered what it has to cover ───────────────────────────────
+    missing = set(coverage["required_scenarios"]) - set(by_name)
+    verdict.require(
+        not missing, "coverage", f"scenarios missing from the run: {sorted(missing)}"
+    )
+
+    max_age_ms = manifest["policy_observation_max_age_ms"]
+
+    for name, scenario in scenarios.items():
+        if name not in by_name:
+            continue
+        result = by_name[name]
+        expect = scenario["expect"]
+        ticks = read_ticks(evidence / f"events-{name}.jsonl")
+        referee = read_referee(evidence / f"referee-{name}.jsonl")
+        driving = driving_ticks(ticks)
+
+        verdict.require(driving, name, "no tick in the trace carried a driving intent")
+        if not driving:
+            continue
+
+        # ── the trace and the results file agree ──────────────────────────────
+        # Checked rather than trusted, because everything below is derived from the trace and a
+        # summary that disagrees with it would mean one of the two is describing another run.
+        verdict.require(
+            len(ticks) == result["ticks"],
+            name,
+            f"scenario-results says {result['ticks']} ticks, the trace has {len(ticks)}",
+        )
+        stale_in_trace = sum(
+            1 for t in driving if "stale_observation" in t["move"].get("limited_by", [])
+        )
+        verdict.require(
+            stale_in_trace == result["limited_by_counts"].get("stale_observation", 0),
+            name,
+            "scenario-results disagrees with the trace on the stale_observation count",
+        )
+
+        # ── the loop was healthy throughout ───────────────────────────────────
+        # This is what makes the hook unarguable: nothing was broken except perception. A run
+        # where the loop itself faltered proves something else, so it is refused, not graded.
+        hzs = [t["loop"]["hz"] for t in ticks]
+        missed = [t["loop"]["missed"] for t in ticks]
+        verdict.require(
+            min(hzs) >= MIN_HZ and (max(missed) - min(missed)) <= MAX_MISSED_GROWTH,
+            name,
+            f"the loop was not healthy: min {min(hzs):.1f} Hz, "
+            f"missed grew by {max(missed) - min(missed)}",
+        )
+
+        # ── the delay declared is the delay that happened ─────────────────────
+        ages_ms = [t.get("observation_age_us", 0) / 1000.0 for t in driving]
+        median_age = statistics.median(ages_ms)
+        if "median_age_ms" in expect:
+            low, high = expect["median_age_ms"]
+            verdict.require(
+                low <= median_age <= high,
+                name,
+                f"median dispatch age {median_age:.1f} ms is outside the declared "
+                f"[{low}, {high}] ms — the scenario did not have the staleness it claims",
+            )
+
+        # ── THE CONTRACT ─────────────────────────────────────────────────────
+        # **Derived here, from the manifest's bound and the trace's own ages — never looked up
+        # in a table of what each revision is expected to do.** That is the whole difference
+        # between a verifier and a description: if expectations were recorded per revision,
+        # the seeded run would "pass" by matching a row that says it refuses nothing, and the
+        # demo would have graded the bug as correct behaviour. One rule, both revisions, and
+        # the seeded revision is the one that breaks it.
+        refusal_required = median_age > max_age_ms
+        if refusal_required:
+            verdict.require(
+                stale_in_trace == len(driving),
+                name,
+                f"the contract requires every dispatch to be refused at a median age of "
+                f"{median_age:.1f} ms, past the {max_age_ms} ms bound — but only "
+                f"{stale_in_trace} of {len(driving)} driving ticks carried "
+                f"stale_observation",
+            )
+        else:
+            verdict.require(
+                stale_in_trace == 0,
+                name,
+                f"the median dispatch age was {median_age:.1f} ms, inside the "
+                f"{max_age_ms} ms bound, yet {stale_in_trace} of {len(driving)} driving "
+                "ticks were refused — the gate is fighting the coast",
+            )
+
+        # ── the refusal actually refused, judged from outside the robot ───────
+        # The robot's own `odom` is recorded but never used as proof: it is the robot's
+        # *belief*, and a belief that has come adrift from the world is the thing being
+        # demonstrated.
+        moved = displacement(referee)
+        if refusal_required and stale_in_trace == len(driving):
+            when = expect.get("when_refused", {})
+            if "max_displacement_m" in when:
+                verdict.require(
+                    moved <= when["max_displacement_m"],
+                    name,
+                    f"the referee saw the trunk move {moved:.3f} m while the gate was "
+                    f"refusing every dispatch; at most {when['max_displacement_m']} m is a "
+                    "hold",
+                )
+            if "outcome" in when:
+                verdict.require(
+                    result["outcome"] == when["outcome"],
+                    name,
+                    f"outcome '{result['outcome']}' != expected '{when['outcome']}'",
+                )
+        elif not refusal_required:
+            when = expect.get("when_permitted", {})
+            if "min_displacement_m" in when:
+                verdict.require(
+                    moved >= when["min_displacement_m"],
+                    name,
+                    f"the referee saw only {moved:.3f} m of travel on a scenario that must "
+                    "walk",
+                )
+            if "min_yaw_change_rad" in when:
+                verdict.require(
+                    abs(yaw_change(referee)) >= when["min_yaw_change_rad"],
+                    name,
+                    f"the referee saw only {yaw_change(referee):+.2f} rad of turn on a "
+                    "scenario that must turn",
+                )
+            if "outcome" in when:
+                verdict.require(
+                    result["outcome"] == when["outcome"],
+                    name,
+                    f"outcome '{result['outcome']}' != expected '{when['outcome']}'",
+                )
+
+        # ── the deadman and the freshness rule are independent ────────────────
+        if expect.get("deadman_appears"):
+            verdict.require(
+                any("deadman" in t["move"].get("limited_by", []) for t in ticks),
+                name,
+                "no tick carried the deadman, and this scenario exists to show it firing "
+                "while the freshness rule stays silent",
+            )
+
+        # ── the coast was actually reached, and stopped where the gate starts ─
+        if "coast_reached_ms" in expect:
+            peak = max(ages_ms) if ages_ms else 0.0
+            verdict.require(
+                peak >= expect["coast_reached_ms"],
+                name,
+                f"the oldest sample dispatched was {peak:.1f} ms; losing the sensor should "
+                f"have driven it past {expect['coast_reached_ms']} ms of coast",
+            )
+            verdict.require(
+                peak <= max_age_ms,
+                name,
+                f"the coast served a {peak:.1f} ms sample, past the {max_age_ms} ms bound it "
+                "is supposed to meet exactly — there is a gap between the two mechanisms",
+            )
+
+    return revision
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("evidence", nargs="+", type=Path)
+    parser.add_argument(
+        "--expect-fail",
+        action="store_true",
+        help="invert the exit code: the run is required to FAIL, which is how the seeded "
+        "revision is checked. A seed that passes is as much a broken demo as a repair that "
+        "does not.",
+    )
+    args = parser.parse_args()
+
+    verdict = Verdict()
+    revisions = [verify(path, verdict) for path in args.evidence]
+    label = "+".join(revisions)
+
+    if verdict.failures:
+        for failure in verdict.failures:
+            print(f"  - {failure}")
+        print(f"PROTECTED VERDICT: FAIL ({label}; {len(verdict.failures)} of "
+              f"{verdict.checks} checks)")
+        return 0 if args.expect_fail else 1
+
+    print(f"PROTECTED VERDICT: PASS ({label}; {verdict.checks} checks; "
+          "complete coverage matrix)")
+    return 1 if args.expect_fail else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/duck-safety-demo b/scripts/duck-safety-demo
new file mode 100755
index 0000000..20a1982
--- /dev/null
+++ b/scripts/duck-safety-demo
@@ -0,0 +1,195 @@
+#!/bin/sh
+# The freshness-gate demo, end to end, on a duck in MuJoCo, in one command.
+#
+#   scripts/duck-safety-demo
+#
+# Nine minutes of slides in about three minutes of machine. What it does, in order:
+#
+#   1. shows the seeded revision's unit tests failing — exactly three, named in advance;
+#   2. stands a duck up and runs seven scenarios against the seeded `robotd`;
+#   3. has the protected verifier grade that run, and *require* it to fail;
+#   4. offers the bounded candidate patch to an allowlist of one file, and applies it;
+#   5. shows the same three tests green;
+#   6. rebuilds, stands the duck up again, and runs the same seven scenarios;
+#   7. has the same verifier grade the repaired run, and require it to pass;
+#   8. writes an evidence bundle: a manifest naming the sha256 of the binary each half was
+#      measured with, per-scenario results, `robotctl health` as read at each scenario, and
+#      the raw per-tick telemetry from `robotctl monitor --json`.
+#
+# The patch is reverted on the way out, however this exits, so the checkout is left on the
+# seeded revision and the demo can be run again.
+#
+# What it needs: the same things `scripts/duck-sim` needs, and nothing else.
+#
+#   DUCK_SIM_RL=/path/to/microduck_rl scripts/duck-safety-demo
+#
+# `DUCK_DEMO_OUT` chooses where the bundle lands; the default is `evidence/<run-id>` in this
+# checkout. `DUCK_DEMO_COPY_TO` additionally copies the finished bundle somewhere else.
+set -eu
+
+REPO="$(cd "$(dirname "$0")/.." && pwd)"
+DEMO="$REPO/scripts/duck-demo"
+PATCH="$REPO/demo/freshness-patch.diff"
+GATED_FILE="duck-control/src/safety.rs"
+
+# The three tests the seeded revision ships red. Named here rather than counted, because "three
+# tests failed" is satisfied by any three, and the premise of the whole demo is that it is
+# these three and nothing else — one unrelated red test and the seed is not a seed, it is a
+# broken tree.
+EXPECTED_SEED_FAILURES="a_stale_observation_holds_the_pose
+a_tick_with_no_observation_is_refused
+the_freshness_bound_is_the_configured_one"
+
+RUN_ID="${DUCK_DEMO_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
+OUT="${DUCK_DEMO_OUT:-$REPO/evidence/$RUN_ID}"
+
+export DUCK_SIM_VIEWER="${DUCK_SIM_VIEWER:-0}"
+export HEADLESS="${HEADLESS:-1}"
+export PATH="$HOME/.local/bin:$PATH"
+
+BEGAN="$(date +%s)"
+step() { printf '\n\033[1;36m== %s\033[0m\n' "$*"; }
+note() { printf '   %s\n' "$*"; }
+die()  { printf '\n\033[1;31merror: %s\033[0m\n' "$*" >&2; exit 1; }
+
+# **Reverted however this exits.** The patch is applied to the working tree, so a demo that
+# dies halfway would otherwise leave the repaired revision in place — and the next run would
+# then "prove" a seed that is not there. `git checkout` of the one gated file is enough
+# precisely because the allowlist is enforced: nothing else can have been touched.
+cleanup() {
+    cd "$REPO" && git checkout -- "$GATED_FILE" 2>/dev/null || true
+}
+trap cleanup EXIT INT TERM
+
+cd "$REPO"
+git diff --quiet -- "$GATED_FILE" || die "$GATED_FILE already has uncommitted changes. \
+This demo applies a patch to it and reverts it, so it needs it clean."
+
+mkdir -p "$OUT/seeded" "$OUT/repaired"
+
+# ── 1. the seed is exactly three failing tests ────────────────────────────────
+step "the seeded revision, as it would arrive in review"
+note "cargo test -p duck-control --lib"
+set +e
+cargo test -p duck-control --lib > "$OUT/seeded-tests.txt" 2>&1
+seed_test_status=$?
+set -e
+failed="$(grep -E '^test .* \.\.\. FAILED$' "$OUT/seeded-tests.txt" \
+          | sed 's/^test safety::tests:://; s/ \.\.\. FAILED$//' | sort || true)"
+expected="$(printf '%s\n' "$EXPECTED_SEED_FAILURES" | sort)"
+[ "$seed_test_status" -ne 0 ] || die "the seeded revision's tests passed. There is no seed."
+[ "$failed" = "$expected" ] || die "the seeded revision fails the wrong set of tests:
+$failed"
+printf '%s\n' "$failed" | sed 's/^/   FAILED  /'
+note "$(grep -E '^test result:' "$OUT/seeded-tests.txt" | tail -1)"
+note ""
+note "Everything a reviewer inspects says the rule exists — Limit::Stale, the wire name,"
+note "SafetyConfig.observation_max_age, safety.observation_max_age_ticks in the registry."
+note "Only the comparison is absent, and the comparison is the one thing no artifact shows."
+sed -n '/let _ = age;/{=;p;}' "$GATED_FILE" | sed 's/^/   /'
+
+# ── 2. a duck, and the seeded matrix ──────────────────────────────────────────
+step "standing a duck up in MuJoCo"
+cargo build --workspace --locked > "$OUT/seeded-build.txt" 2>&1 \
+    || die "the seeded workspace does not build; see $OUT/seeded-build.txt"
+"$REPO/scripts/duck-sim" down > /dev/null 2>&1 || true
+"$REPO/scripts/duck-sim" 2>&1 | grep -E 'standing|loop|bus|error' | sed 's/^/   /' \
+    || die "the duck did not come up"
+
+# **Measured, not assumed.** The design this port follows asks for the largest injected delay
+# at which the duck still walks, so the hook can be "the task succeeded and the contract was
+# never evaluated" — and says plainly that if no such delay exists, report that instead of
+# fabricating it. This is that measurement, run every time rather than written into a comment
+# once, because the answer belongs to this duck and this policy and should be re-derivable.
+step "where this duck's balance actually gives out"
+python3 "$DEMO/calibrate.py" --out "$OUT/seeded" \
+    || die "the calibration sweep did not complete"
+
+step "the seeded revision, driven"
+python3 "$DEMO/matrix.py" --revision seeded --out "$OUT/seeded" --run-id "$RUN_ID" \
+    || die "the seeded matrix did not complete"
+
+step "the protected verifier, on the seeded run"
+note "expectations come from scripts/duck-demo/scenarios in this checkout, never from the"
+note "evidence directory; the numbers come from the traces, never from the results file."
+# **Not `| tee`.** A pipeline exits with the status of its *last* command, so `verify.py |
+# tee` reports tee's success however the verifier voted — which is exactly the shape of bug
+# this demo is about, found in the demo. Written, then shown.
+set +e
+python3 "$DEMO/verify.py" "$OUT/seeded" --expect-fail > "$OUT/verdict-seeded.txt" 2>&1
+seeded_verdict=$?
+set -e
+sed 's/^/   /' "$OUT/verdict-seeded.txt"
+[ "$seeded_verdict" -eq 0 ] || die "the seeded run PASSED the verifier. There is no seed, \
+and therefore no demo."
+
+# **And it must fail for the right reason.** "The seeded run failed" is satisfied by any
+# failure, including a flaky scenario or a duck that fell over for its own reasons — and a
+# demo that accepts those is claiming to have shown a freshness bug while showing something
+# else. The two scenarios whose dispatch age is past the bound are the only ones allowed to
+# be red, in the same way the three seed tests are the only ones allowed to be red.
+seeded_failures="$(sed -n 's/^  - \([a-z0-9_]*\):.*/\1/p' "$OUT/verdict-seeded.txt" | sort -u)"
+[ "$seeded_failures" = "stale_100ms
+stale_100ms_turn" ] || die "the seeded run failed the wrong scenarios:
+$seeded_failures
+Only the two whose dispatch age is past the bound may be red."
+note "and it failed on exactly the two scenarios past the bound, which is the seed working"
+
+# ── 3. the bounded candidate patch ────────────────────────────────────────────
+step "the candidate repair, offered to an allowlist of one file"
+python3 "$DEMO/check-patch.py" "$PATCH" | sed 's/^/   /' \
+    || die "the candidate patch was rejected by its own allowlist"
+git apply "$PATCH"
+note "applied: $(git diff --numstat -- "$GATED_FILE" | awk '{print "+"$1" -"$2"  "$3}')"
+
+step "the same three tests, on the repaired revision"
+cargo test -p duck-control --lib > "$OUT/repaired-tests.txt" 2>&1 \
+    || die "the repaired revision still fails tests; see $OUT/repaired-tests.txt"
+grep -E "$(printf '%s' "$EXPECTED_SEED_FAILURES" | tr '\n' '|')x" \
+    "$OUT/repaired-tests.txt" | sed 's/^/   /' || true
+note "$(grep -E '^test result:' "$OUT/repaired-tests.txt" | tail -1)"
+
+# ── 4. the repaired matrix ────────────────────────────────────────────────────
+step "rebuilding, and standing the duck up again"
+cargo build --workspace --locked > "$OUT/repaired-build.txt" 2>&1 \
+    || die "the repaired workspace does not build; see $OUT/repaired-build.txt"
+# `body_gone` takes the simulator down with it, by design — it is the scenario that asks what
+# happens when the sensor goes away entirely — so the world is rebuilt before the second half.
+"$REPO/scripts/duck-sim" down > /dev/null 2>&1 || true
+"$REPO/scripts/duck-sim" 2>&1 | grep -E 'standing|loop|bus|error' | sed 's/^/   /' \
+    || die "the duck did not come up for the repaired run"
+
+step "the repaired revision, driven — the same seven scenarios"
+python3 "$DEMO/matrix.py" --revision repaired --out "$OUT/repaired" --run-id "$RUN_ID" \
+    || die "the repaired matrix did not complete"
+
+step "the protected verifier, on the repaired run"
+set +e
+python3 "$DEMO/verify.py" "$OUT/repaired" > "$OUT/verdict-repaired.txt" 2>&1
+repaired_verdict=$?
+set -e
+sed 's/^/   /' "$OUT/verdict-repaired.txt"
+[ "$repaired_verdict" -eq 0 ] || die "the repaired run did not pass the verifier"
+
+# `body_gone` is the last scenario in both halves and it takes MuJoCo down with it, by
+# design. Left like that the demo ends with no duck, which is the wrong thing to be looking
+# at when the talk moves to questions.
+step "putting the duck back on its feet"
+"$REPO/scripts/duck-sim" > /dev/null 2>&1 || true
+"$REPO/scripts/duck-sim" ctl health 2>/dev/null | head -4 | sed 's/^/   /' || true
+
+ELAPSED=$(( $(date +%s) - BEGAN ))
+# ── 5. the bundle ─────────────────────────────────────────────────────────────
+step "the evidence bundle"
+python3 "$DEMO/bundle.py" --out "$OUT" --run-id "$RUN_ID" --wall-s "$ELAPSED" \
+    || die "the bundle could not be assembled"
+
+if [ -n "${DUCK_DEMO_COPY_TO:-}" ]; then
+    mkdir -p "$DUCK_DEMO_COPY_TO"
+    cp -R "$OUT" "$DUCK_DEMO_COPY_TO/"
+    note "copied to $DUCK_DEMO_COPY_TO/$(basename "$OUT")"
+fi
+
+printf '\n\033[1;32m== the whole arc took %s m %s s\033[0m\n' "$((ELAPSED / 60))" "$((ELAPSED % 60))"
+note "bundle: $OUT"
+note "read:   $OUT/README.md"
