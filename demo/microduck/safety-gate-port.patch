+        let mut s = Safety::new(FakeIo::at(DEFAULT_POSITION), tight);
+        let applied = s
+            .apply(DEFAULT_POSITION, DEFAULT_POSITION, tight.gain_running, age)
+            .unwrap();
+        assert!(applied.limited_by(Limit::Stale), "{:?}", applied.limits);
+
+        let loose = SafetyConfig {
+            observation_max_age: Duration::from_secs(10),
+            ..SafetyConfig::default()
+        };
+        let mut s = Safety::new(FakeIo::at(DEFAULT_POSITION), loose);
+        let applied = s
+            .apply(DEFAULT_POSITION, DEFAULT_POSITION, loose.gain_running, age)
+            .unwrap();
+        assert!(
+            !applied.limited_by(Limit::Stale),
+            "the very same age, under a bound that permits it: {:?}",
+            applied.limits
+        );
+    }
+
+    /// **No observation at all is not a young one.**
+    ///
+    /// The case that matters most, and the one a runtime check is likeliest to get backwards:
+    /// past the coast the loop has no sample to offer, and a rule that only compares numbers
+    /// it was given would wave that tick through. Losing the sensor entirely must not
+    /// default-authorize.
+    #[test]
+    fn a_tick_with_no_observation_is_refused() {
+        let mut wanted = DEFAULT_POSITION;
+        wanted[2] = 0.4;
+
+        let mut s = safety();
+        let applied = s
+            .apply(
+                wanted,
+                DEFAULT_POSITION,
+                SafetyConfig::default().gain_running,
+                None,
+            )
+            .unwrap();
+
+        assert!(applied.limited_by(Limit::Stale), "{:?}", applied.limits);
+        assert_eq!(s.io().last_written.unwrap().positions, DEFAULT_POSITION);
+    }
+
+    /// The shipped default is the bound `robotd`'s coast already implies, not a number chosen
+    /// for a slide: `(COAST_TICKS + 1)` control periods, which is four ticks of 20 ms at the
+    /// 50 Hz this robot runs at. If either the coast or the loop rate ever changes, this is
+    /// the test that says the two have drifted apart.
+    #[test]
+    fn the_default_bound_is_four_control_periods() {
+        const COAST_TICKS: u32 = 3;
+        let period = Duration::from_millis(20);
+        assert_eq!(
+            SafetyConfig::default().observation_max_age,
+            period * (COAST_TICKS + 1)
+        );
+    }
 }
