--- /dev/null
+++ b/scripts/duck-demo/referee.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""Ground truth about where the duck actually is, taken from outside the duck.
+
+A second reader on the body's own port. body_server.py says why its `read` reply carries
+`trunk` and `trunk_z` at all:
+
+    "No robot can measure how high its own trunk is, and serde ignores these on the daemon
+     side."
+
+That is exactly the property wanted here. Under a stale observation the robot's `odom` is
+its *belief*, and the whole failure being demonstrated is a belief that has come adrift from
+the world — so a verdict derived from `odom` would be asking the defendant for the verdict.
+`trunk` comes from `data.qpos` with the world's own lock held, and nothing robotd does can
+reach it.
+
+The body server is a `ThreadingTCPServer`, so this connection is its own thread and `read`
+only takes the lock to copy state out. Watching costs the simulator nothing it was not
+already paying to answer the daemon.
+"""
+
+import json
+import socket
+import threading
+import time
+
+
+class Referee:
+    """Samples the body's true trunk pose on its own thread until stopped."""
+
+    def __init__(self, port=7801, host="127.0.0.1", hz=50.0):
+        self.address = (host, port)
+        self.period = 1.0 / hz
+        self.samples = []
+        self._stop = threading.Event()
+        self._thread = None
+        self._error = None
+
+    def __enter__(self):
+        self.start()
+        return self
+
+    def __exit__(self, *exc):
+        self.stop()
+        return False
+
+    def start(self):
+        ready = threading.Event()
+        self._thread = threading.Thread(target=self._run, args=(ready,), daemon=True)
+        self._thread.start()
+        # Wait for the handshake so a scenario never starts before the referee is watching.
+        ready.wait(5.0)
+        if self._error:
+            raise RuntimeError(f"referee could not reach the body: {self._error}")
+
+    def stop(self):
+        self._stop.set()
+        if self._thread:
+            self._thread.join(3.0)
+
+    def _run(self, ready):
+        try:
+            s = socket.create_connection(self.address, timeout=5)
+            s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+            f = s.makefile("rw")
+            f.write(json.dumps({"op": "hello", "protocol": 1, "joints": 15}) + "\n")
+            f.flush()
+            f.readline()
+        except Exception as error:  # noqa: BLE001 - reported to the caller, not swallowed
+            self._error = error
+            ready.set()
+            return
+        ready.set()
+        while not self._stop.is_set():
+            began = time.perf_counter()
+            try:
+                f.write('{"op":"read"}\n')
+                f.flush()
+                reply = json.loads(f.readline())
+            except Exception as error:  # noqa: BLE001
+                # The body going away mid-scenario is itself a result (see `body_gone`), not a
+                # crash: record it and stop, so the caller still gets the samples up to it.
+                self._error = error
+                return
+            self.samples.append(
+                {
+                    "wall": time.time(),
+                    "sim_time": reply.get("sim_time"),
+                    "trunk": reply.get("trunk"),
+                    "trunk_z": reply.get("trunk_z"),
+                    "gravity_z": reply.get("imu", {}).get("gravity", [0, 0, 0])[2],
+                    "yaw": yaw_of(reply.get("imu", {}).get("quat", [1, 0, 0, 0])),
+                }
+            )
+            slack = self.period - (time.perf_counter() - began)
+            if slack > 0:
+                time.sleep(slack)
+
+    # ── what the verifier asks of it ──────────────────────────────────────────
+
+    def write(self, path):
+        with open(path, "w") as out:
+            for sample in self.samples:
+                out.write(json.dumps(sample) + "\n")
+
+    def window(self, began, ended):
+        return [s for s in self.samples if began <= s["wall"] <= ended]
+
+
+def yaw_of(quat):
+    """Heading from the trunk quaternion the body reports, radians.
+
+    From the simulator's `qpos`, not from the robot's own odometry: which way the duck is
+    actually pointing is the thing a stale observation makes it wrong about, so it has to come
+    from the world.
+    """
+    import math
+
+    w, x, y, z = quat
+    return math.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))
+
+
+def turned(samples):
+    """Radians of heading change, first sample to last, unwrapped across the +/-pi seam."""
+    import math
+
+    if len(samples) < 2:
+        return 0.0
+    total, last = 0.0, samples[0]["yaw"]
+    for sample in samples[1:]:
+        step = sample["yaw"] - last
+        total += math.atan2(math.sin(step), math.cos(step))
+        last = sample["yaw"]
+    return total
+
+
+def displacement(samples):
+    """Metres travelled in the world's own xy plane, first sample to last."""
+    if len(samples) < 2:
+        return 0.0
+    a, b = samples[0]["trunk"], samples[-1]["trunk"]
+    return ((b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2) ** 0.5
+
+
+def main():
+    import argparse
+
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--port", type=int, default=7801)
+    parser.add_argument("--seconds", type=float, default=3.0)
+    parser.add_argument("--out")
+    args = parser.parse_args()
+    with Referee(port=args.port) as referee:
+        time.sleep(args.seconds)
+    if args.out:
+        referee.write(args.out)
+    print(
+        json.dumps(
+            {
+                "samples": len(referee.samples),
+                "displacement_m": round(displacement(referee.samples), 4),
+                "trunk_z_final": referee.samples[-1]["trunk_z"] if referee.samples else None,
+            }
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
