diff --git a/scripts/duck-demo/bundle.py b/scripts/duck-demo/bundle.py
new file mode 100644
index 0000000..a7ef27d
--- /dev/null
+++ b/scripts/duck-demo/bundle.py
@@ -0,0 +1,305 @@
+#!/usr/bin/env python3
+"""Assemble the two halves of a run into one bundle, and write the summary a reader starts at.
+
+Everything here is copied or derived from what the run produced. Nothing is asserted that is
+not in `scenario-results.json`, a trace, or a `robotctl health` capture taken at the moment
+the scenario ran. Where a claim the demo would like to make is not supported by the numbers,
+this says so rather than making it.
+"""
+
+import argparse
+import json
+import time
+from pathlib import Path
+
+
+def load(root, revision):
+    base = Path(root) / revision
+    manifest = json.loads((base / "manifest.json").read_text())
+    results = json.loads((base / "scenario-results.json").read_text())
+    health = json.loads((base / "health.json").read_text())
+    return manifest, {r["scenario"]: r for r in results}, health
+
+
+def verdict_line(path):
+    """The verifier's one-line ruling, without the reasons it gives above it."""
+    if not path.exists():
+        return None
+    for line in path.read_text().splitlines():
+        if line.startswith("PROTECTED VERDICT:"):
+            return line.strip()
+    return None
+
+
+def verdict_detail(path):
+    """Everything the verifier said *before* the ruling: why, one reason per entry."""
+    if not path.exists():
+        return []
+    return [
+        line.strip().lstrip("- ").strip()
+        for line in path.read_text().splitlines()
+        if line.strip().startswith("-")
+    ]
+
+
+def health_line(text):
+    """The loop's own line out of `robotctl health`, which is the telemetry a reader wants."""
+    for line in (text or "").splitlines():
+        if "Hz" in line:
+            return line.strip()
+    return None
+
+
+def wrap(text, width=88):
+    words, lines, line = text.split(), [], ""
+    for word in words:
+        if len(line) + len(word) + 1 > width:
+            lines.append(line)
+            line = word
+        else:
+            line = f"{line} {word}".strip()
+    if line:
+        lines.append(line)
+    return lines
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True, type=Path)
+    parser.add_argument("--run-id", required=True)
+    parser.add_argument("--wall-s", type=int, required=True)
+    args = parser.parse_args()
+
+    seeded_manifest, seeded, seeded_health = load(args.out, "seeded")
+    calibration_path = args.out / "seeded" / "calibration.json"
+    calibration = (
+        json.loads(calibration_path.read_text()) if calibration_path.exists() else None
+    )
+    repaired_manifest, repaired, repaired_health = load(args.out, "repaired")
+
+    rows = []
+    flipped = []
+    for name in seeded:
+        a, b = seeded[name], repaired.get(name)
+        if b is None:
+            continue
+        row = {
+            "scenario": name,
+            "stale_sensors_ms": a["stale_sensors_ms"],
+            "median_dispatch_age_ms": round(a["observation_age_us"]["p50"] / 1000, 1),
+            "seeded": {
+                "outcome": a["outcome"],
+                "stale_observation_ticks": a["limited_by_counts"].get(
+                    "stale_observation", 0
+                ),
+                "driving_ticks": a["driving_ticks"],
+                "referee_displacement_m": a["referee"]["displacement_m"],
+                "referee_trunk_z_final": a["referee"]["trunk_z_final"],
+                "referee_upright": a["referee"]["upright"],
+                "odom_displacement_m": a["odom_displacement_m"],
+                "loop_hz_median": a["loop"]["hz_median"],
+                "health_at_scenario": health_line(seeded_health.get(name)),
+            },
+            "repaired": {
+                "outcome": b["outcome"],
+                "stale_observation_ticks": b["limited_by_counts"].get(
+                    "stale_observation", 0
+                ),
+                "driving_ticks": b["driving_ticks"],
+                "referee_displacement_m": b["referee"]["displacement_m"],
+                "referee_trunk_z_final": b["referee"]["trunk_z_final"],
+                "referee_upright": b["referee"]["upright"],
+                "odom_displacement_m": b["odom_displacement_m"],
+                "loop_hz_median": b["loop"]["hz_median"],
+                "health_at_scenario": health_line(repaired_health.get(name)),
+            },
+        }
+        row["verdict_flipped"] = (
+            row["seeded"]["stale_observation_ticks"]
+            != row["repaired"]["stale_observation_ticks"]
+        )
+        if row["verdict_flipped"]:
+            flipped.append(name)
+        rows.append(row)
+
+    rows.sort(key=lambda r: r["scenario"])
+
+    summary = {
+        "run_id": args.run_id,
+        "created_unix_ms": int(time.time() * 1000),
+        "wall_time_s": args.wall_s,
+        "revisions": {
+            "seeded": {
+                "git_commit": seeded_manifest["source"]["git_commit"],
+                "executable_sha256": seeded_manifest["executable"]["sha256"],
+                "verdict": verdict_line(args.out / "verdict-seeded.txt"),
+                "verdict_detail": verdict_detail(args.out / "verdict-seeded.txt"),
+            },
