@@ -0,0 +1,172 @@
+#!/usr/bin/env python3
+"""Run the whole scenario matrix against one revision, and write its evidence directory.
+
+One `robotd` per staleness value, several scenarios inside each. The MuJoCo world stays up
+across all of them because it is the expensive part, and because killing `robotd` runs its
+graceful shutdown — which sits the duck down and cuts torque — so every swap costs a stand
+and six seconds of settle, or the next scenario is a measurement of a duck on the floor.
+
+What this writes is *facts*. It does not decide whether they are the right facts:
+`verify.py` does that, from expectations in its own checkout.
+"""
+
+import argparse
+import hashlib
+import json
+import shutil
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import run as runner  # noqa: E402
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for block in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_scenarios():
+    return [
+        json.loads(path.read_text())
+        for path in sorted((HERE / "scenarios").glob("*.json"))
+    ]
+
+
+def git(*args):
+    return subprocess.run(
+        ["git", *args], cwd=REPO, capture_output=True, text=True
+    ).stdout.strip()
+
+
+def params_say():
+    """What the params registry advertises the freshness bound to be.
+
+    From `robotd-params/src/registry.rs` in this checkout, not from a running daemon: there is
+    no `robotctl params list`, and `configure --list` prints only what a robot *changes* from
+    the defaults — so a robot running the default 4 ticks prints nothing, which is the answer
+    to a different question. Recorded because the seeded revision's plausibility rests on it:
+    the registry says the rule exists, and the registry is one of the artifacts a reviewer
+    inspects before concluding it does.
+    """
+    registry = REPO / "robotd-params/src/registry.rs"
+    lines = registry.read_text().splitlines()
+    for index, line in enumerate(lines):
+        if "observation_max_age_ticks" in line:
+            return {
+                "source": "robotd-params/src/registry.rs",
+                "line": index + 1,
+                "entry": " ".join(part.strip() for part in lines[index : index + 3]),
+            }
+    return None
+
+
+def health(robotctl, sock):
+    """`robotctl health` verbatim — the loop telemetry, in the words the operator sees."""
+    out = subprocess.run(
+        [str(robotctl), "--robot-socket", str(sock), "health"],
+        capture_output=True,
+        text=True,
+    )
+    return out.stdout
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--revision", required=True, choices=["seeded", "repaired"])
+    parser.add_argument("--out", required=True, type=Path)
+    parser.add_argument("--state", default=str(Path.home() / ".cache/duck-sim"))
+    parser.add_argument("--body-port", type=int, default=7801)
+    parser.add_argument("--run-id", default=None)
+    args = parser.parse_args()
+
+    state = Path(args.state)
+    sock = state / "duck-a.sock"
+    robotctl = REPO / "target/debug/robotctl"
+    robotd = REPO / "target/debug/robotd"
+    out = args.out
+    out.mkdir(parents=True, exist_ok=True)
+
+    # The binary is copied and digested *before* anything is measured with it, so the evidence
+    # names the executable that produced it rather than whatever is at that path afterwards.
+    artifact = out / "artifact"
+    artifact.mkdir(exist_ok=True)
+    shutil.copy2(robotd, artifact / "robotd")
+    binary_sha = sha256(artifact / "robotd")
+    (artifact / "robotd.sha256").write_text(f"{binary_sha}  robotd\n")
+
+    scenarios = load_scenarios()
+    results = []
+    current_stale = None
+    began = time.perf_counter()
+    health_by_scenario = {}
+
+    for scenario in scenarios:
+        want = scenario.get("stale_ms", 0)
+        if want != current_stale:
+            print(f"   -- robotd restart, --stale-sensors-ms {want}", flush=True)
+            subprocess.run(
+                [str(HERE / "swap-robotd.sh"), str(want)],
+                check=True,
+                capture_output=True,
+            )
+            current_stale = want
+        print(f"   -- {scenario['name']}", end="", flush=True)
+        # Captured per scenario, immediately before it: the hook rests on every instrument
+        # reporting a healthy robot at the moment the contract is being violated, and that is
+        # only evidence if it was actually read at that moment.
+        health_by_scenario[scenario["name"]] = health(robotctl, sock)
+        result = runner.run(scenario, str(sock), args.body_port, out, robotctl)
+        result["revision"] = args.revision
+        results.append(result)
+        print(
+            f"  -> {result['outcome']}"
+            f"  age_p50={result['observation_age_us']['p50'] / 1000:.1f}ms"
+            f"  limits={result['limited_by_counts'] or '{}'}",
+            flush=True,
+        )
+
+    wall = time.perf_counter() - began
+    (out / "scenario-results.json").write_text(json.dumps(results, indent=2) + "\n")
+    (out / "health.json").write_text(json.dumps(health_by_scenario, indent=2) + "\n")
+
+    manifest = {
+        "run_id": args.run_id or out.name,
+        "created_unix_ms": int(time.time() * 1000),
+        "revision": args.revision,
+        "source": {
+            "git_commit": git("rev-parse", "HEAD"),
+            "git_dirty": bool(git("status", "--porcelain")),
+            "patch_applied": (
+                "demo/freshness-patch.diff" if args.revision == "repaired" else None
+            ),
+        },
+        "executable": {"path": "artifact/robotd", "sha256": binary_sha},
+        "control": {"target_hz": 50.0, "period_ms": 20, "coast_ticks": 3},
+        "simulator": {"backend": "microduck_rl", "body_port": args.body_port, "headless": True},
+        "policy_observation_max_age_ticks": 4,
+        "policy_observation_max_age_ms": 80,
+        "params_registry_entry": params_say(),
+        "scope": "matrix",
+        "scenarios": [s["name"] for s in scenarios],
+        "wall_time_s": round(wall, 2),
+        # Carried verbatim from the demo this is a port of, because it is still true here:
+        "caveat": (
+            "A digest identifies an artifact; it is not by itself independent proof that "
+            "untrusted evidence was produced by that executable."
+        ),
+    }
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    print(f"   -- matrix ({args.revision}) took {wall:.1f} s", flush=True)
+
+
+if __name__ == "__main__":
+    main()
