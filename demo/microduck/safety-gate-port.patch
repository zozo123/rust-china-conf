+++ b/scripts/duck-demo/run.py
@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+"""Run one scenario against a duck that is already up, and write its evidence.
+
+Three recorders, deliberately independent:
+
+  * `robotctl monitor --json`, spawned as a real client and captured verbatim — this is what
+    the robot says about itself, including the new `observation_age_us`;
+  * `referee.py` on the body port — this is what the world says about the robot;
+  * a `robot.move` writer on its own connection — the driver's intent, at the 10 Hz a
+    teleoperator's stick produces, so the deadman is exercised the way it is in the field.
+
+Nothing here decides anything. It records, and `verify.py` — which reads its expectations
+from its own checkout rather than from this directory — derives the verdict.
+"""
+
+import argparse
+import json
+import os
+import signal
+import socket
+import statistics
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from referee import Referee, displacement, turned  # noqa: E402
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+
+# A duck is standing when its trunk clears this, the same 0.095 m `duck-sim`'s own `upright`
+# uses — "`STAND` is 0.12 and `SIT` is 0.07; halfway is the line".
+STANDING_M = 0.095
+
+
+def quiesce(sock_path, seconds):
+    """Let the robot finish with whatever it was last asked to do."""
+    time.sleep(seconds)
+
+
+def drive(sock_path, vx, vy, vyaw, seconds, stop_early=None):
+    """Hold an intent for `seconds`, at 10 Hz, on a connection of its own."""
+    s = socket.socket(socket.AF_UNIX)
+    s.connect(sock_path)
+    f = s.makefile("w")
+    until = time.time() + seconds
+    while time.time() < until:
+        if stop_early and stop_early():
+            break
+        f.write(
+            json.dumps(
+                {
+                    "jsonrpc": "2.0",
+                    "method": "robot.move",
+                    "params": {"vx": vx, "vy": vy, "vyaw": vyaw},
+                }
+            )
+            + "\n"
+        )
+        f.flush()
+        time.sleep(0.1)
+    s.close()
+
+
+def run(scenario, sock_path, body_port, out_dir, robotctl):
+    name = scenario["name"]
+    out_dir = Path(out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    events_path = out_dir / f"events-{name}.jsonl"
+    referee_path = out_dir / f"referee-{name}.jsonl"
+
+    # **Wait for the previous scenario to be finished with the robot.** The deadman holds the
+    # last intent on record for 500 ms and the applied twist then decays toward zero over
+    # several more ticks, so a scenario that starts recording immediately captures the tail of
+    # the one before it — which showed up as `fresh_turn` opening with thirteen ticks of
+    # `fresh_walk`'s forward twist, and a turn measured across a window that began by walking.
+    quiesce(sock_path, scenario.get("settle_before_s", 1.2))
+
+    events = open(events_path, "w")
+    monitor = subprocess.Popen(
+        [str(robotctl), "--robot-socket", str(sock_path), "monitor", "--json", "--hz", "50"],
+        stdout=events,
+        stderr=subprocess.DEVNULL,
+    )
+    referee = Referee(port=body_port)
+    referee.start()
+    # Let both recorders settle before the intent starts, so the first driving tick is inside
+    # the window rather than racing it.
+    time.sleep(0.4)
+
+    began_wall = time.time()
+    began = time.perf_counter()
+    kill_body_at = scenario.get("kill_body_after_s")
+    killed_body = False
+
+    if kill_body_at is None:
+        drive(
+            sock_path,
+            scenario.get("vx", 0.0),
+            scenario.get("vy", 0.0),
+            scenario.get("vyaw", 0.0),
+            scenario["drive_s"],
+        )
+    else:
+        # `body_gone`: hold the intent, take the sensor away mid-stride, keep holding it.
+        def past_kill():
+            nonlocal killed_body
+            if not killed_body and time.perf_counter() - began >= kill_body_at:
+                killed_body = True
+                subprocess.run(
+                    ["pkill", "-KILL", "-f", "body_server"], check=False, capture_output=True
+                )
+            return False
+
+        drive(
+            sock_path,
+            scenario.get("vx", 0.0),
+            scenario.get("vy", 0.0),
+            scenario.get("vyaw", 0.0),
+            scenario["drive_s"],
+            stop_early=past_kill,
+        )
+
+    # `silence_s`: stop talking and let the deadman do its work, still recording.
+    time.sleep(scenario.get("silence_s", 0.0))
+    ended_wall = time.time()
+    wall_ms = int((time.perf_counter() - began) * 1000)
+
+    time.sleep(0.3)
+    referee.stop()
+    monitor.send_signal(signal.SIGTERM)
+    try:
+        monitor.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        monitor.kill()
+    events.close()
+    referee.write(referee_path)
+
+    result = summarise(
+        scenario, events_path, referee, began_wall, ended_wall, wall_ms, killed_body
+    )
+    return result
+
+
+def summarise(scenario, events_path, referee, began_wall, ended_wall, wall_ms, killed_body):
+    ticks = []
+    with open(events_path) as stream:
+        for line in stream:
+            try:
+                frame = json.loads(line)
+            except json.JSONDecodeError:
+                continue
+            state = frame.get("params")
+            if not isinstance(state, dict) or "loop" not in state:
+                continue
+            ticks.append(state)
+
+    # A *driving* tick is one where the driver was actually asking for motion. Limits are only
+    # interesting there: a tick with no intent is limited by the deadman by definition, and
+    # counting those would make every scenario look gated.
+    driving = [t for t in ticks if any(abs(v) > 1e-9 for v in requested(t))]
+    limited = {}
+    for tick in driving:
+        for limit in tick["move"].get("limited_by", []):
+            limited[limit] = limited.get(limit, 0) + 1
+
+    ages = [t.get("observation_age_us", 0) for t in driving] or [0]
+    hzs = [t["loop"]["hz"] for t in ticks] or [0.0]
+    missed = [t["loop"]["missed"] for t in ticks] or [0]
+
+    window = referee.window(began_wall, ended_wall) or referee.samples
+    moved = displacement(window)
+    turn = turned(window)
+    trunk_z_first = window[0]["trunk_z"] if window else None
+    trunk_z_final = window[-1]["trunk_z"] if window else None
+    gravity_z_final = window[-1]["gravity_z"] if window else None
+
+    upright = trunk_z_final is not None and trunk_z_final >= STANDING_M
+    upright_at_start = trunk_z_first is not None and trunk_z_first >= STANDING_M
+    # Refused *throughout*, not merely somewhere: a gate that trips on a handful of ticks is a
+    # different event from one that never lets a single stale sample through, and calling both
+    # "held" would hide the more interesting of the two.
+    refused_all = driving and limited.get("stale_observation", 0) >= len(driving)
+
+    # **`held` outranks `fell`, and the order matters.** A duck the gate has refused since boot
+    # has never stood up, and it is not lying on the floor because it fell — it is exactly
+    # where it was put. Judging it by trunk height alone would report the rule working as the
+    # rule failing. `trunk_z_start` is recorded next to `trunk_z_final` so the difference
+    # between "went down" and "never got up" is in the evidence rather than in this function.
+    if refused_all and moved < 0.05:
+        outcome = "held"
+    elif not upright:
+        outcome = "fell"
+    elif moved >= 0.15:
+        outcome = "walked"
+    elif abs(turn) >= 0.5:
+        outcome = "turned"
+    else:
+        outcome = "stopped"
+
+    return {
+        "scenario": scenario["name"],
+        "stale_sensors_ms": scenario.get("stale_ms", 0),
+        "intent": {
+            "vx": scenario.get("vx", 0.0),
+            "vy": scenario.get("vy", 0.0),
+            "vyaw": scenario.get("vyaw", 0.0),
+            "drive_s": scenario["drive_s"],
+            "silence_s": scenario.get("silence_s", 0.0),
+        },
+        "outcome": outcome,
+        "ticks": len(ticks),
+        "driving_ticks": len(driving),
+        "limited_by_counts": limited,
+        "observation_age_us": {
+            "p50": int(statistics.median(ages)),
+            "p95": int(sorted(ages)[min(len(ages) - 1, int(0.95 * len(ages)))]),
+            "max": int(max(ages)),
+        },
+        "loop": {
+            "hz_min": round(min(hzs), 2),
+            "hz_median": round(statistics.median(hzs), 2),
+            "missed_growth": int(max(missed) - min(missed)),
+        },
+        "referee": {
+            "samples": len(window),
+            "displacement_m": round(moved, 4),
+            "yaw_change_rad": round(turn, 4),
+            "trunk_z_start": round(trunk_z_first, 4) if trunk_z_first is not None else None,
+            "trunk_z_final": round(trunk_z_final, 4) if trunk_z_final is not None else None,
+            "gravity_z_final": (
+                round(gravity_z_final, 4) if gravity_z_final is not None else None
+            ),
+            "upright": upright,
+            "upright_at_start": upright_at_start,
+        },
+        "odom_displacement_m": round(odom_displacement(driving or ticks), 4),
+        "body_killed": killed_body,
+        "wall_time_ms": wall_ms,
+    }
+
+
+def requested(tick):
+    """`move.requested` is `skip_serializing_if = "Vec::is_empty"` on the wire, so an idle tick
+    carries no field at all rather than three zeros. Absent is not motion."""
+    return tick.get("move", {}).get("requested", [])
+
+
+def odom_displacement(ticks):
+    """What the robot *believes* it travelled. Recorded, never used as proof — under a stale
+    observation this is exactly the number that comes adrift from `referee.trunk`."""
+    if len(ticks) < 2:
+        return 0.0
+    a = ticks[0].get("odom", {}).get("position", [0.0, 0.0, 0.0])
+    b = ticks[-1].get("odom", {}).get("position", [0.0, 0.0, 0.0])
+    return ((b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2) ** 0.5
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("scenario", type=Path)
+    parser.add_argument("--socket", default=os.path.expanduser("~/.cache/duck-sim/duck-a.sock"))
+    parser.add_argument("--body-port", type=int, default=7801)
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--robotctl", default=str(REPO / "target/debug/robotctl"))
+    args = parser.parse_args()
+
+    scenario = json.loads(args.scenario.read_text())
+    result = run(scenario, args.socket, args.body_port, args.out, args.robotctl)
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
