+/// How old the sample a tick's targets were computed from is, *right now*.
+///
+/// No `Default`, no `ZERO`, no `From<Duration>`, no public field: the only way to obtain one
+/// is to hand over the [`Sensors`] it is about. So "the observation was fresh" stops being a
+/// claim a caller can make, forget, or get wrong — the type asks for the sample, every time,
+/// and a caller holding no observation has nothing to offer.
+///
+/// Measured at the point it is asked for, not at the read, because what the safety layer
+/// needs to know is how old the world is *at the instant the motors are commanded*. An
+/// inference that took 8 ms makes the sample 8 ms older, and it is the dispatch that has to
+/// answer for that.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub struct ObservationAge(Duration);
+
+impl ObservationAge {
+    pub fn of(sensors: &Sensors) -> Self {
+        Self(sensors.observed_at.elapsed())
+    }
+
+    pub fn exceeds(&self, max: Duration) -> bool {
+        self.0 > max
+    }
+
+    pub fn as_millis(&self) -> u128 {
+        self.0.as_millis()
+    }
+
+    /// Microseconds, for the state stream. Saturating rather than wrapping: a robot that has
+    /// been blind for six hundred thousand years is still blind, and an age that wrapped to a
+    /// small number would read as fresh.
+    pub fn as_micros(&self) -> u64 {
+        u64::try_from(self.0.as_micros()).unwrap_or(u64::MAX)
+    }
+}
