@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""Find where this duck's balance actually gives out, and record it whatever it says.
+
+The design this port follows asks for a calibration before the matrix is final: pick the
+largest injected delay at which the duck still *succeeds*, so the demo can show a task that
+completed while the contract it advertises was never evaluated. It also says, in as many
+words, that if no such delay exists the honest thing is to report that rather than fabricate
+the hook.
+
+This is that step, kept in the demo rather than done once and written into a comment, because
+the answer is a property of this duck and this policy and would otherwise be a claim nobody
+can re-derive. It sweeps the band between the last delay the duck walks through and the
+bound the gate enforces, and prints what it finds.
+"""
+
+import argparse
+import json
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import run as runner  # noqa: E402
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[1]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True, type=Path)
+    parser.add_argument("--state", default=str(Path.home() / ".cache/duck-sim"))
+    parser.add_argument("--body-port", type=int, default=7801)
+    parser.add_argument(
+        "--delays",
+        default="60,80",
+        help="injected delays to sweep, ms. The matrix already measures 0, 40 and 100, so the "
+        "default fills in the band between the last one the duck walks through and the "
+        "first one past the bound.",
+    )
+    parser.add_argument("--max-age-ms", type=float, default=80.0)
+    args = parser.parse_args()
+
+    sock = Path(args.state) / "duck-a.sock"
+    robotctl = REPO / "target/debug/robotctl"
+    args.out.mkdir(parents=True, exist_ok=True)
+
+    rows = []
+    began = time.perf_counter()
+    for delay in [int(d) for d in args.delays.split(",")]:
+        subprocess.run(
+            [str(HERE / "swap-robotd.sh"), str(delay)], check=True, capture_output=True
+        )
+        scenario = {
+            "name": f"calibrate_{delay}ms",
+            "stale_ms": delay,
+            "vx": 0.3,
+            "drive_s": 2.5,
+        }
+        result = runner.run(scenario, str(sock), args.body_port, args.out, robotctl)
+        age = result["observation_age_us"]["p50"] / 1000.0
+        row = {
+            "injected_ms": delay,
+            "median_dispatch_age_ms": round(age, 1),
+            "past_the_bound": age > args.max_age_ms,
+            "outcome": result["outcome"],
+            "referee_displacement_m": result["referee"]["displacement_m"],
+            "referee_trunk_z_final": result["referee"]["trunk_z_final"],
+            "referee_upright": result["referee"]["upright"],
+            "odom_displacement_m": result["odom_displacement_m"],
+            "loop_hz_median": result["loop"]["hz_median"],
+            # The point of the whole exercise: the robot walked, or believes it did, and the
+            # rule that would have stopped it was never consulted.
+            "stale_observation_ticks": result["limited_by_counts"].get(
+                "stale_observation", 0
+            ),
+        }
+        rows.append(row)
+        print(
+            f"   -- injected {delay:>3} ms -> age {age:6.1f} ms  {row['outcome']:8}"
+            f"  travelled {row['referee_displacement_m']:.3f} m"
+            f"  trunk_z {row['referee_trunk_z_final']}",
+            flush=True,
+        )
+
+    # The question the sweep exists to answer, answered from the sweep.
+    walks_past_the_bound = [
+        r for r in rows if r["past_the_bound"] and r["outcome"] == "walked"
+    ]
+    finding = {
+        "question": (
+            "Is there an injected delay at which the dispatch age exceeds the "
+            f"{args.max_age_ms:.0f} ms bound and the duck still walks?"
+        ),
+        "answer": "yes" if walks_past_the_bound else "no",
+        "consequence": (
+            "The demo can show a task that succeeded while the contract was never evaluated."
+            if walks_past_the_bound
+            else "On this duck the balance cliff sits below the bound the coast implies, so "
+            "there is no 'the robot succeeded, the contract failed' case to show. What the "
+            "seeded revision demonstrates instead is stronger and is not a weaker version of "
+            "it: the duck goes down while the loop holds fifty hertz, the bus is ok, the imu "
+            "is ready, limited_by is empty, and the age sits on the wire the whole time."
+        ),
+        "rows": rows,
+        "wall_time_s": round(time.perf_counter() - began, 1),
+    }
+    (args.out / "calibration.json").write_text(json.dumps(finding, indent=2) + "\n")
+    print(f"   -- calibration: {finding['answer']}")
+
+
+if __name__ == "__main__":
+    main()
